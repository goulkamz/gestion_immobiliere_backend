# Genere au demarrage par l'image nginx (envsubst) : seules les variables
# d'environnement API_DOMAIN et MEDIAS_DOMAIN sont remplacees, pas $host & co.

server_tokens off;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# ---------------------------------------------------------------------------
# HTTP : validation Let's Encrypt, sinon redirection vers HTTPS
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name ${API_DOMAIN} ${MEDIAS_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/acme;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Tout autre nom d'hote (scan, IP directe) : connexion fermee sans reponse
server {
    listen 80 default_server;
    server_name _;
    return 444;
}

# ---------------------------------------------------------------------------
# API -> backend Spring Boot
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # Aligne sur SERVLET_MULTIPART_MAX_REQUEST_SIZE (uploads multiples de medias)
    client_max_body_size 200m;

    location / {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Ecrase (et ne complete pas) l'en-tete du client : ClientIpResolver lit la
        # premiere adresse, un client ne doit pas pouvoir y placer une fausse IP.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

# ---------------------------------------------------------------------------
# Medias -> MinIO (lecture seule : photos publiques et URLs presignees)
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${MEDIAS_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${MEDIAS_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${MEDIAS_DOMAIN}/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;

    proxy_buffering off;

    location / {
        # Le backend ecrit dans MinIO par le reseau interne : rien a ecrire d'ici
        limit_except GET HEAD {
            deny all;
        }
        proxy_pass http://minio:9000;
        # Host intact : la signature des URLs presignees en depend
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
