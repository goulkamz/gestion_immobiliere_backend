# Modele de .env pour la PRODUCTION. Copier en .env sur le serveur, puis remplacer chaque <...>.
# Les secrets se generent avec : bash generer-secrets.sh
# Ne jamais commiter le vrai .env.

# --- Profil et migrations -------------------------------------------------
PROFILES_ACTIVE=prod
# FLYWAY_LOCATIONS : NE PAS DEFINIR. Le seed de dev vide les tables (TRUNCATE) : il ne doit jamais tourner en production.

# --- Premier administrateur (cree au demarrage sur base vide) -------------
BOOTSTRAP_ADMIN_EMAIL=<email-de-l-administrateur>
BOOTSTRAP_ADMIN_PASSWORD=<mot-de-passe-fort-a-changer-apres-la-premiere-connexion>
BOOTSTRAP_ADMIN_NOM=<nom>
BOOTSTRAP_ADMIN_PRENOM=<prenom>

# --- Domaines -------------------------------------------------------------
WEB_DOMAIN=<exemple.com>
API_DOMAIN=<api.exemple.com>
BASE_URL=https://<api.exemple.com>
CORS_ALLOWED_ORIGINS=https://<exemple.com>
LETSENCRYPT_EMAIL=<contact@exemple.com>
# IP ou reseau du reverse proxy (nginx) pour lire l'adresse reelle du client
SECURITY_TRUSTED_PROXIES=<ip-ou-reseau-du-proxy>

# --- Cookies et jetons ----------------------------------------------------
JWT_COOKIE_SECURE=true
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
JWT_SECRET_ACCESS=<genere>
JWT_SECRET_REFRESH=<genere>
FINGER_SECRET_KEY=<genere>
GI_BF_DOCUMENTS_SECRET=<genere>

# --- Base, cache, stockage ------------------------------------------------
POSTGRES_PASSWORD=<genere>
REDIS_PASSWORD=<genere>
MINIO_ROOT_USER=<identifiant-non-standard>
MINIO_ROOT_PASSWORD=<genere>
MINIO_REGION=us-east-1
MINIO_ENDPOINT=http://minio:9000

# --- Medias ---------------------------------------------------------------
MEDIAS_MAX_SIZE_IMAGE_MO=5
MEDIAS_MAX_SIZE_VIDEO_MO=50
SERVLET_MULTIPART_MAX_FILE_SIZE=60MB
SERVLET_MULTIPART_MAX_REQUEST_SIZE=200MB

# --- E-mail (compte expediteur dedie a l'application) ---------------------
MAIL_HOST=<smtp.exemple.com>
MAIL_PORT=587
MAIL_USERNAME=<utilisateur-smtp>
MAIL_PASSWORD=<mot-de-passe-smtp>
MAIL_FROM=<no-reply@exemple.com>
MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true

# --- Notifications --------------------------------------------------------
# Laisser VIDE : sinon tous les e-mails clients sont rediriges vers cette adresse.
NOTIFICATIONS_EMAIL_REDIRECTION=

# --- Logs -----------------------------------------------------------------
# Ne pas definir LOGGING_LEVEL_ORG_HIBERNATE_TYPE_DESCRIPTOR_SQL_BASICBINDER (TRACE ecrit les valeurs SQL dans les logs).
